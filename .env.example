# 浏览器默认同源访问，Vite将/api转发到本机API服务。
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8787
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173
# 使用电脑名访问时将名称加入此处；直接使用局域网IP无需添加。
VITE_ALLOWED_HOSTS=terminal.local,localhost
MSS_API_HOST=0.0.0.0
MSS_API_PORT=8787
# 仅当前后端跨域直连时填写，例如：http://192.168.1.20:5173
CORS_ORIGINS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mss_stocking
