{
  "name": "mss-sample-stocking-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "dev:api:ts": "tsx server/src/index.ts",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:server": "tsc && node -e \"const fs=require('fs');const path=require('path');const src=path.join(process.cwd(),'server/src/db/migrations');const dest=path.join(process.cwd(),'dist/api/db/migrations');fs.mkdirSync(dest,{recursive:true});fs.cpSync(src,dest,{recursive:true});console.log('[BUILD] Copied SQL migrations to dist/api/db/migrations');\"",
    "start:server": "node dist/api/index.js",
    "preview": "vite preview",
    "build:all": "npm run build && npm run build:server",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:api": "node --import tsx --test tests/api-v1.test.mjs",
    "test": "npm run test:api && npm run test:sites"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@tabler/icons-react": "^3.35.0",
    "@vitejs/plugin-react": "5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.2",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
